# Normaliza quebras de linha: LF no repositorio, nativo no working dir.
# Evita diffs fantasma de 500+ linhas entre Windows e CI/Linux (Vercel).
* text=auto eol=lf

# Binarios: nunca normalizar
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Scripts que precisam de CRLF no Windows
*.bat   text eol=crlf
*.cmd   text eol=crlf
